{
  "name": "session-atlas-app",
  "productName": "Session Atlas",
  "private": true,
  "version": "0.1.0",
  "description": "Session Atlas desktop app: browse Claude Code sessions and resume them in a built-in terminal.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "mkdir -p lib && cp ../scripts/extract.mjs ../scripts/demo-data.mjs lib/ && esbuild renderer/editor-src.js --bundle --format=iife --minify --outfile=renderer/editor.bundle.js",
    "start": "bun run build && electron .",
    "demo": "bun run build && ATLAS_DEMO=1 electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty && bun run build",
    "dist": "bun run build && electron-builder --mac dir --arm64",
    "install-app": "bun run dist && rm -rf '/Applications/Session Atlas.app' && ditto 'dist/mac-arm64/Session Atlas.app' '/Applications/Session Atlas.app' && rm -rf 'dist/mac-arm64/Session Atlas.app'"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electron/rebuild": "3.7.1",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "io.github.giorgiod91.session-atlas",
    "productName": "Session Atlas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "loops.mjs",
      "preload.cjs",
      "icon.png",
      "lib/**",
      "renderer/**",
      "demo/**",
      "!renderer/editor-src.js"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": "dir"
    }
  }
}
